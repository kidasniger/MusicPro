<?xml version="1.0" encoding="utf-8"?><!--
   Règles de sauvegarde (Android &lt; 12) : le fichier chiffré de la clé API
   Groq est exclu des sauvegardes, car la clé maître du Keystore Android est
   liée au matériel et ne voyage pas ; restaurer le fichier chiffré sans elle
   le rend illisible.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="musicpro_groq_encrypted_prefs.xml" />
</full-backup-content>
