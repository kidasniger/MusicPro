<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permet de partager les APK téléchargés dans le cache interne de l'application -->
    <cache-path name="apk_cache" path="updates/" />
    <!-- Mise à jour 070 : cartes de morceaux générées pour le partage -->
    <cache-path name="share_cards" path="share/" />
    <!-- Permet de partager les fichiers du dossier externe Downloads si besoin -->
    <external-cache-path name="apk_external_cache" path="updates/" />
</paths>
